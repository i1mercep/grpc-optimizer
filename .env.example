OPT_LISTEN_ADDR=127.0.0.1:50051
# Defaults to available parallelism; concurrent solves default to budget / threads.
# OPT_CPU_BUDGET=4
OPT_SOLVER_THREADS=1
# OPT_MAX_CONCURRENT_SOLVES=4
OPT_MAX_ACTIVE_RPCS=32
OPT_MAX_MESSAGE_BYTES=16777216
OPT_MAX_COLLECT_BYTES=16777216
OPT_MAX_BATCH_JOBS=64
OPT_STREAM_WINDOW=8
OPT_DEFAULT_TIME_LIMIT_SECONDS=30
OPT_MAX_TIME_LIMIT_SECONDS=300
OPT_MAX_VARIABLES=100000
OPT_MAX_CONSTRAINTS=100000
OPT_MAX_NONZEROS=1000000
RUST_LOG=grpc_optimizer=info
# Rust CLI and benchmark:
OPT_ENDPOINT=http://127.0.0.1:50051
# Python client (native gRPC target syntax):
OPT_GRPC_TARGET=127.0.0.1:50051
